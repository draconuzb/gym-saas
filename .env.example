# ─── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=gym_admin
DB_PASSWORD=change_me_to_a_strong_password
DB_NAME=gym_system

# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,https://gym.bizdaoson.uz

# ─── Authentication ──────────────────────────────────────────
# Use a 64-char random hex: openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string

# ─── Telegram Bot Manager ────────────────────────────────────
# In SaaS v2, every gym has its OWN bot token (stored in the gyms table).
# These env vars only control the bot manager itself:
#   ENABLE_BOTS=false        — disable all bots (e.g. for migration runs)
#   ENABLE_WORKER=false      — disable cron worker
#   BOT_USE_WEBHOOK=true     — use webhooks (production); else long-polling
#   WEBHOOK_BASE=https://gym.bizdaoson.uz   — required if BOT_USE_WEBHOOK=true
ENABLE_BOTS=true
ENABLE_WORKER=true
BOT_USE_WEBHOOK=false
WEBHOOK_BASE=

# ─── Payment Gateways (shared across gyms) ──────────────────
# These remain global; per-gym Payme/Click merchant IDs can be added
# to the gyms table later if needed.
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# ─── Frontend (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=
